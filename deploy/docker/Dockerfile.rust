# ---- Builder Stage ----
FROM rust:1.94-slim-bookworm AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY rust/ .

RUN cargo build --release

# ---- Runtime Stage ----
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/me /usr/local/bin/me
COPY --from=builder /app/target/release/ome /usr/local/bin/ome
COPY --from=builder /app/target/release/gateway /usr/local/bin/gateway
COPY --from=builder /app/target/release/persistence /usr/local/bin/persistence

# Default entrypoint — override per service via docker-compose or K8s command
ENTRYPOINT ["me"]
